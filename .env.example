# Copy to .env and fill in what you have. Every source except Google suggestions needs a key;
# sources without keys are skipped automatically.

# Claude (required for classify/report). Or run `ant auth login` instead.
ANTHROPIC_API_KEY=
# Optional override - default is claude-opus-5-5. claude-haiku-5-5 is far cheaper for large runs.
# CLAUDE_MODEL=claude-opus-5-5

# Reddit official API - create a "script" app at https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
USER_AGENT=recycling-pain-points-research/0.1 (by u/your_reddit_username)

# X API v2 bearer token (recent search needs the Basic tier or above)
X_BEARER_TOKEN=

# YouTube Data API v3 key (Google Cloud console, free daily quota)
YOUTUBE_API_KEY=

# Brave Search API key - complaint/review sites, forums, Quora (free tier available)
BRAVE_API_KEY=

# Node only uses HTTPS_PROXY when this is set (needed behind corporate proxies)
# NODE_USE_ENV_PROXY=1
